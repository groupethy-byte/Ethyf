rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for individual user documents and their subcollections
    match /users/{userId} {
      // Allow any authenticated user to read other user profiles (e.g., for inviting members)
      allow read: if request.auth != null;
      // Allow a user to write ONLY to their own document.
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Master Data (Banks, Kategori, Subkategori): Allow read by any auth user (so family members can see names)
      match /banks/{document=**} { allow read: if request.auth != null; allow write: if request.auth.uid == userId; }
      match /kategori/{document=**} { allow read: if request.auth != null; allow write: if request.auth.uid == userId; }
      match /subkategori/{document=**} { allow read: if request.auth != null; allow write: if request.auth.uid == userId; }

      // Private Data (Transaksi Personal): Only owner can read/write
      match /transaksi/{document=**} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    }

    // Rules for family documents and their subcollections
    match /families/{familyId} {
      // A user can create a family if they set themselves as the owner and sole member.
      allow create: if request.auth.uid == request.resource.data.ownerUid &&
                     request.resource.data.memberUids == [request.auth.uid];

      // A user can read a family document if they are a member.
      allow read: if request.auth.uid in resource.data.memberUids;

      // Update permissions are more granular.
      allow update: if
        // Condition 1: A new user is joining by accepting a valid invitation.
        (
            // The user is not yet a member.
            !(request.auth.uid in resource.data.memberUids) &&
            // They are only allowed to change memberUids and updatedAt.
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
            // Ensure the new list contains the user and all previous members.
            request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
            request.auth.uid in request.resource.data.memberUids &&
            request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
            // And a pending invitation for them exists and is 'pending'.
            // We check for existence first to prevent errors on get().
            exists(/databases/$(database)/documents/invitations/$(familyId + '_' + request.auth.uid)) &&
            get(/databases/$(database)/documents/invitations/$(familyId + '_' + request.auth.uid)).data.status == 'pending'
        ) ||
        // Condition 2: The owner is making changes (e.g., removing a member, changing name).
        (
            request.auth.uid == resource.data.ownerUid
        );

      // Allow delete if the user is the owner
      allow delete: if request.auth.uid == resource.data.ownerUid;

      // Allow read/write on all subcollections (banks, kategori, subkategori, transaksi)
      // within a family document, only if the user is a member of that family.
      match /{subCollection}/{docId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
      }
    }

    // Rules for invitations
    match /invitations/{invitationId} {
      function isFamilyOwner(familyId) {
        return exists(/databases/$(database)/documents/families/$(familyId)) &&
               get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
      }

      // Helper function to check if a user is a member of the family associated with this invitation.
      // It derives the familyId from the invitation's ID string.
      function isMemberOfAssociatedFamily(invId, userId) {
        let familyId = invId.split('_')[0];
        return exists(/databases/$(database)/documents/families/$(familyId)) &&
               userId in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
      }

      // Allow read if user is a member of the family OR if they are the specific invitee.
      allow read: if request.auth != null && (
        isMemberOfAssociatedFamily(invitationId, request.auth.uid) ||
        (resource != null && resource.data.inviteeUid == request.auth.uid)
      );

      // Allow create if user is the inviter AND the owner of the family
      allow create: if request.auth != null &&
        request.resource.data.inviterUid == request.auth.uid &&
        isFamilyOwner(request.resource.data.familyId);

      // Allow update if user is the invitee (accept/reject), the original inviter, or the current family owner.
      allow update: if request.auth != null && (
        resource.data.inviteeUid == request.auth.uid ||
        resource.data.inviterUid == request.auth.uid ||
        isFamilyOwner(request.resource.data.familyId) || // Check new data on overwrite
        isFamilyOwner(resource.data.familyId) // Check old data
      );

      // Allow the inviter OR the family owner to cancel/delete the invitation
      allow delete: if request.auth != null && (resource.data.inviterUid == request.auth.uid || isFamilyOwner(resource.data.familyId));
    }
  }
}
