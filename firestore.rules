rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for individual user documents and their subcollections
    match /users/{userId} {
      // Allow any authenticated user to read other user profiles (e.g., for inviting members)
      allow read: if request.auth != null;
      // WARNING: This rule is too broad for production. It allows any authenticated user to write to ANY user document.
      // For production, consider: `allow write: if request.auth != null && request.auth.uid == userId;`
      allow write: if request.auth != null;

      // Allow a user to read/write their own subcollections (banks, kategori, subkategori, transaksi)
      // This applies to users who are not part of a family or whose family is not Pro.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Rules for family documents and their subcollections
    match /families/{familyId} {
      // Allow any authenticated user to create a new family document
      allow create: if request.auth != null;
      // Allow read/write on the family document itself only if the user is a member of that family
      allow read, write: if request.auth != null && request.auth.uid in resource.data.memberUids;

      // Allow read/write on all subcollections (banks, kategori, subkategori, transaksi)
      // within a family document, only if the user is a member of that family.
      match /{subCollection}/{docId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
      }
    }

    // Rules for invitations
    match /invitations/{invitationId} {
      // Allow read if user is the invitee OR a member of the target family
      allow read: if request.auth != null && (
        resource.data.inviteeUid == request.auth.uid ||
        (request.auth.uid in get(/databases/$(database)/documents/families/$(resource.data.familyId)).data.memberUids)
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.inviteeUid == request.auth.uid ||
        resource.data.inviterUid == request.auth.uid
      );
      // Allow the inviter (admin) to cancel/delete the invitation
      allow delete: if request.auth != null && resource.data.inviterUid == request.auth.uid;
    }
  }
}
